# screenmates backend configuration — copy to .env and fill in.

# TMDB — get a key at https://www.themoviedb.org/settings/api
# Works with either a v3 API key or a v4 bearer token (starts with "ey").
TMDB_API_KEY=
TMDB_LANGUAGE=de-DE
TMDB_REGION=DE

# LLM for the "KI-Suche" tab (optional). Anthropic-compatible by default.
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_MODEL=claude-opus-4-8

# App
DATABASE_URL=sqlite:///./screenmates.db
SESSION_COOKIE=screenmates_sid
CORS_ORIGINS=http://localhost:5173
