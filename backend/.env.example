# screenmates backend configuration — copy to .env and fill in what you need.
# Everything is optional: without keys the app runs on its seed catalogue.

# TMDB — https://www.themoviedb.org/settings/api
# Either a v3 API key or a v4 read access token (starts with "ey").
TMDB_API_KEY=
# Language of film data and region for "Where's it on?", e.g. en-US and US.
TMDB_LANGUAGE=en-US
TMDB_REGION=US

# AI search: an Anthropic key or an OpenRouter key (sk-or-…, detected automatically).
LLM_API_KEY=
# Optional: LLM_PROVIDER=anthropic|openrouter, LLM_MODEL, LLM_BASE_URL (any OpenAI-compatible API).
# Defaults: Anthropic claude-opus-5-5, OpenRouter deepseek/deepseek-v4.1-flash (inexpensive).
# LLM_MODEL=

# Cinema (live screen sharing). Needs the MediaMTX media server next to screenmates:
# `make kino-install` locally (then `make dev` wires it up), or `docker compose up`.
# MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889
# MEDIAMTX_API_URL=http://127.0.0.1:9997

# Storage. Relative sqlite paths resolve against the working directory.
# DATABASE_URL=sqlite:////data/screenmates.db

# Web Push: a contact the browsers' push services may use (mailto: or https: URL).
# The keys are generated on first use and kept in the database. Push needs HTTPS.
# PUSH_CONTACT=mailto:admin@example.org

# Set COOKIE_SECURE=true when the app is served over HTTPS.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
